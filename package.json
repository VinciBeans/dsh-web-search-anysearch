{
  "name": "@wenqi_bian/dsh-web-search-anysearch",
  "version": "0.1.3-alpha.2",
  "description": "AnySearch-backed WebSearchProvider for DeepSeek Harness (dsh): register AnySearch's /v1/search, switch explicitly between the official DeepSeek search endpoint and AnySearch from the Plugins settings page card, compatible with dsh v0.1.2-alpha.1 ~ v0.1.5-alpha.1 (the 0.1.2 line is legacy; see README).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "anysearch",
    "web-search"
  ],
  "license": "MIT",
  "homepage": "https://github.com/VinciBeans/dsh-web-search-anysearch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VinciBeans/dsh-web-search-anysearch.git"
  },
  "bugs": {
    "url": "https://github.com/VinciBeans/dsh-web-search-anysearch/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "index.d.ts",
    "client.d.ts",
    "examples",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/provider.test.mjs tests/settings.test.mjs tests/client-smoke.test.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-alpha.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-alpha.1",
    "@deepseek-ai/dsh-web": "^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-alpha.1",
    "@deepseek-ai/dsh-web-search-deepseek": "^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-web-search-deepseek": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "file:../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-api-remotes": "file:../../deepseek-harness/packages/api/remotes",
    "@deepseek-ai/dsh-client-locale": "file:../../deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-renderer": "file:../../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-settings": "file:../../deepseek-harness/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-slots": "file:../../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-credentials": "file:../../deepseek-harness/packages/credentials/credentials",
    "@deepseek-ai/dsh-launch-environment": "file:../../deepseek-harness/packages/util/launch-environment",
    "@deepseek-ai/dsh-settings": "file:../../deepseek-harness/packages/settings/settings",
    "@deepseek-ai/dsh-web": "file:../../deepseek-harness/packages/web/web",
    "@deepseek-ai/dsh-web-search-deepseek": "file:../../deepseek-harness/packages/web/web-search-deepseek",
    "@deepseek-ai/schemastery": "file:../../deepseek-harness/vendor/schemastery",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.2",
    "react": "^18.2.0",
    "typescript": "^5.6.3"
  }
}
